CONFIG_ESP32_WIFI_NVS_ENABLED=n
CONFIG_MGMT_AP_SSID="crx3"
CONFIG_BT_ENABLED=n
CONFIG_LWIP_MAX_SOCKETS=16
# This project needs its own partitions.csv (defines the "storage" SPIFFS
# partition the web UI/SPIFFS data lives on) instead of ESP-IDF's built-in
# single-app table. This was previously only baked into the tracked
# sdkconfig itself (never in this defaults file), so deleting sdkconfig for
# a clean regen silently lost it and broke the SPIFFS image build.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# Also only ever baked into the tracked sdkconfig, never in this file:
# max CPU clock and flash read speed, presumably tuned for attack throughput.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# Same story again — these were only ever baked into the tracked sdkconfig,
# never mirrored here, so a clean regen silently reset them to ESP-IDF's
# generic defaults. Found by diffing VALUES (not just key presence like the
# first pass above) between the pre-USB-pivot sdkconfig and a fresh regen.
# Management AP password — Kconfig's own default is "mgmtadmin", not this.
CONFIG_MGMT_AP_PASSWORD="notforfun"
# Scan tab result cap — Kconfig default is 20, halves what used to be visible.
CONFIG_SCAN_MAX_AP=40
# WiFi RX/TX dynamic buffer counts — Kconfig default is 32, halved from what
# this project shipped with; matters for a firmware whose whole point is
# high packet-injection throughput.
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=64
# HTTP header/URI length limits for the web UI's httpd — Kconfig default is
# 512, some browsers send headers long enough to hit that ceiling.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_MAX_URI_LEN=2048
